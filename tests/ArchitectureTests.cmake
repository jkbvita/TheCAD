cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
foreach(layer modeling document application exchange presentation viewport)
    if(layer STREQUAL "modeling")
        set(forbidden "(ui|application|document|presentation|viewport|exchange)")
    elseif(layer STREQUAL "document")
        set(forbidden "(ui|application|presentation|viewport|exchange)")
    elseif(layer STREQUAL "application")
        set(forbidden "(ui|presentation|viewport|exchange)")
    elseif(layer STREQUAL "exchange")
        set(forbidden "(ui|application|document|presentation|viewport)")
    elseif(layer STREQUAL "presentation")
        set(forbidden "(ui|application|document|viewport|exchange)")
    else()
        set(forbidden "(ui|application|document|exchange)")
    endif()
    file(GLOB_RECURSE sources "${SOURCE_ROOT}/src/${layer}/*.h" "${SOURCE_ROOT}/src/${layer}/*.cpp")
    foreach(source IN LISTS sources)
        file(READ "${source}" text)
        if(text MATCHES "#[ \t]*include[ \t]*[\"<]${forbidden}/")
            message(FATAL_ERROR "Forbidden layer import in ${source}")
        endif()
        if(text MATCHES "#[ \t]*include[ \t]*[\"<](QtWidgets/|QWidget[>\"]|QMainWindow[>\"]|QTreeWidget[>\"]|QDialog[>\"]|QApplication[>\"])")
            message(FATAL_ERROR "Widget dependency in lower layer ${source}")
        endif()
    endforeach()
endforeach()
message(STATUS "PASS: modeling/document/application/exchange/presentation/viewport import boundaries")
