# Enforce dependency direction at configure time, including GUI-free builds.
function(thecad_layer target allowed)
    if(NOT TARGET ${target})
        return()
    endif()
    get_target_property(dependencies ${target} LINK_LIBRARIES)
    foreach(dependency IN LISTS dependencies)
        if(dependency MATCHES "^thecad_" AND NOT dependency IN_LIST allowed)
            message(FATAL_ERROR "Architecture violation: ${target} depends on ${dependency}")
        endif()
        if(target MATCHES "^thecad_(modeling|document|application|exchange)$" AND dependency MATCHES "^Qt[0-9]*::(Widgets|Gui|Quick|OpenGL)")
            message(FATAL_ERROR "Core layer ${target} must remain independent of Qt GUI libraries")
        endif()
        if(target MATCHES "^thecad_(presentation|graphics)$" AND dependency MATCHES "^Qt[0-9]*::Widgets")
            message(FATAL_ERROR "Rendering layer ${target} must not depend on QWidget")
        endif()
    endforeach()
endfunction()
thecad_layer(thecad_modeling "thecad_occt;thecad_planegcs")
thecad_layer(thecad_document "thecad_modeling")
thecad_layer(thecad_application "thecad_document")
thecad_layer(thecad_exchange "thecad_occt")
thecad_layer(thecad_presentation "thecad_occt")
thecad_layer(thecad_graphics "thecad_modeling;thecad_presentation")
thecad_layer(thecad_widgets "thecad_document")
thecad_layer(thecad_viewport_widget "thecad_application;thecad_graphics;thecad_widgets")
thecad_layer(thecad_ui "thecad_viewport_widget;thecad_widgets;thecad_application;thecad_exchange")
